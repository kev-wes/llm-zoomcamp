# Copy to .env and fill in:  cp .env.example .env

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# --- Postgres (knowledge base + monitoring + n8n state) ---------------------
POSTGRES_USER=docs_assistant
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=docs_assistant

# --- n8n ---------------------------------------------------------------------
# Any random string, at least 24 chars. Used to encrypt stored credentials.
# Generate one with:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-random-string

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Misc --------------------------------------------------------------------
TZ=Europe/Berlin
